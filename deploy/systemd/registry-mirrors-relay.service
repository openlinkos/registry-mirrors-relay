# systemd unit for registry-mirrors-relay. To install:
#   sudo install -m 0755 registry-mirrors-relay /usr/local/bin/
#   sudo install -d /etc/registry-mirrors-relay && sudo install -m 0644 config.yaml /etc/registry-mirrors-relay/
#   sudo install -m 0644 registry-mirrors-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now registry-mirrors-relay
#
# systemd allocates the user dynamically (DynamicUser); the operational data is in /var/lib/registry-mirrors-relay
# (StateDirectory). Keep data_dir in the configuration at its default, /var/lib/registry-mirrors-relay.
# First administrator: the first start writes a generated password to the journal
# (journalctl -u registry-mirrors-relay | grep 'generated password'); sudo registry-mirrors-relay admin password
# sets one at any time. To choose the first one yourself, see LoadCredential below (docs/deploy.md).

[Unit]
Description=registry-mirrors-relay: a container registry mirror that relays and never stores
Documentation=https://github.com/openlinkos/registry-mirrors-relay
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/registry-mirrors-relay serve -config /etc/registry-mirrors-relay/config.yaml
# reload the configuration without interrupting downloads in progress
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# a little longer than timeouts.shutdown_grace (30 seconds)
TimeoutStopSec=45s

DynamicUser=yes
StateDirectory=registry-mirrors-relay
StateDirectoryMode=0700

# Password file for the first administrator (a file only root can read is enough; when systemd passes it to the
# service, only the service can read it).
# The password must be changed after the first sign-in; afterwards these two lines and the password file can be removed.
#LoadCredential=admin-password:/etc/registry-mirrors-relay/admin-password
#Environment=RELAY_ADMIN_PASSWORD_FILE=%d/admin-password

# this capability is needed to listen on ports below 1024 (for example 80 and 443 when facing the internet
# directly); remove it when only high ports such as 8080 are used
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target
